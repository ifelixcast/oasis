{
  "expo": {
    "name": "Whim!",
    "slug": "whim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./client/assets/images/icon.png",
    "scheme": "whim",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#008570",
        "foregroundImage": "./client/assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./client/assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./client/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#008570",
          "image": "./client/assets/images/brand/splash-logo.png",
          "imageWidth": 389
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
